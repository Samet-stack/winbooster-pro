{
  "name": "winbooster-pro",
  "version": "1.0.0",
  "description": "Ultra-low latency, eSport-focused Windows 10/11 Performance & Kernel Optimizer with a Next-Gen HUD UI",
  "author": "WinBooster Open Source Project",
  "main": "electron/main.cjs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "package:win": "vite build && electron-builder --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@tsparticles/engine": "^4.3.2",
    "@tsparticles/react": "^4.3.2",
    "@tsparticles/slim": "^4.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-tsparticles": "^2.12.2",
    "recharts": "^3.10.1",
    "tsparticles": "^4.3.2",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.winbooster.app",
    "productName": "WinBooster",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "dir"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
